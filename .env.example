# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
# Settings → API en el dashboard de Supabase.
# Estas dos son públicas (viajan al browser) y están protegidas por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: SOLO server-side (la usa el cron para escribir fx_rates
# y generar recurrentes sin sesión de usuario). Nunca prefijar con
# NEXT_PUBLIC_ ni exponerla en el cliente: saltea RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# URL pública del deploy. En local: http://localhost:3000
# Se usa para armar el redirect del OAuth de Google.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Cron
# ─────────────────────────────────────────────────────────────
# Secreto que protege /api/cron/fx. Vercel lo manda como
# "Authorization: Bearer <CRON_SECRET>" en los cron jobs.
# Generalo con: openssl rand -hex 32
CRON_SECRET=
